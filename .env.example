# =====================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — CULTIVUS CO (.env.example)
# =====================================================================
# Copia este archivo como .env y completa los valores en tu máquina.
# El .env real está ignorado por Git (.gitignore) y no debe versionarse.
# Spring Boot carga .env automáticamente gracias a:
# spring.config.import=optional:file:./.env[.properties],optional:file:../.env[.properties],optional:file:./demo/.env[.properties]
# =====================================================================

# ── 1. SERVIDOR Y PERFIL ──────────────────────────────────────────────
PORT=
SPRING_PROFILES_ACTIVE=
LOG_LEVEL_APP=

# En producción (Render):
# SPRING_PROFILES_ACTIVE=prod
# THYMELEAF_CACHE=true
# STATIC_CACHE_SECONDS=3600
THYMELEAF_CACHE=
STATIC_CACHE_SECONDS=

# ── 2. BASE DE DATOS (MONGODB) ────────────────────────────────────────
# Local: mongodb://localhost:27017/cultivus
# MongoDB Atlas: mongodb+srv://USUARIO:CLAVE@cluster0.xxxx.mongodb.net/cultivus?retryWrites=true&w=majority
SPRING_DATA_MONGODB_URI=

# ── 3. URL BASE DE LA APLICACIÓN (Recuperación de contraseña) ─────────
# Sin barra (/) al final.
# En Render: https://cultivus-co.onrender.com
APP_BASE_URL=

# ── 4. LÍMITES Y VIGENCIA DE RECUPERACIÓN DE CONTRASEÑA ───────────────
PASSWORD_RESET_TOKEN_TTL=
PASSWORD_RESET_WINDOW=
PASSWORD_RESET_MAX_EMAIL=
PASSWORD_RESET_MAX_IP=
PASSWORD_RESET_MAX_ATTEMPTS=

# ── 5. CORREO (PUENTE HTTPS GOOGLE APPS SCRIPT + SMTP) ───────────────
# URL del script de Google que envía los correos por HTTPS (puerto 443)
# sin bloqueos en Render Free:
MAIL_WEBHOOK_URL=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=
MAIL_STARTTLS=
MAIL_STARTTLS_REQUIRED=
MAIL_SSL=
MAIL_CONNECTION_TIMEOUT_MS=
MAIL_TIMEOUT_MS=
MAIL_WRITE_TIMEOUT_MS=

# --- Alternativa local con Mailpit (sin enviar correos reales) ---
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@cultivus.local
# MAIL_SMTP_AUTH=false
# MAIL_STARTTLS=false
# MAIL_STARTTLS_REQUIRED=false

# ── 6. WOMPI — PASARELA DE PAGOS ──────────────────────────────────────
# Valores por defecto de Sandbox (Pruebas):
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_CURRENCY=
# En producción usar: https://production.wompi.co/v1
WOMPI_API_BASE_URL=
WOMPI_API_TIMEOUT_MS=

# ── 7. LOGÍSTICA / ENVÍO ──────────────────────────────────────────────
CULTIVUS_ENVIO_PROVISIONAL=

# ── 8. OAUTH2 (GOOGLE & FACEBOOK - OPCIONAL) ──────────────────────────
# Google Cloud Console:
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=

# Meta for Developers (Facebook):
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_SCOPE=


# -- 9. CLOUDINARY (fotos de ofertas) --
# Obtenlas en https://console.cloudinary.com (Dashboard > API Keys). NO las subas al repositorio.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
