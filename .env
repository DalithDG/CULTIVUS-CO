# =====================================================================
# ARCHIVO DE VARIABLES DE ENTORNO — CULTIVUS CO (.env)
# =====================================================================
# Spring Boot carga este archivo automáticamente gracias a:
# spring.config.import=optional:file:./.env[.properties],optional:file:../.env[.properties],optional:file:./demo/.env[.properties]
# (No subas este archivo con credenciales reales a Git)
# =====================================================================

# ── 1. SERVIDOR Y PERFIL ──────────────────────────────────────────────
PORT=8080
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL_APP=INFO

# En producción (Render):
# SPRING_PROFILES_ACTIVE=prod
# THYMELEAF_CACHE=true
# STATIC_CACHE_SECONDS=3600
THYMELEAF_CACHE=false
STATIC_CACHE_SECONDS=0

# ── 2. BASE DE DATOS (MONGODB) ────────────────────────────────────────
# Local: mongodb://localhost:27017/cultivus
# MongoDB Atlas: mongodb+srv://USUARIO:CLAVE@cluster0.xxxx.mongodb.net/cultivus?retryWrites=true&w=majority
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/cultivus

# ── 3. URL BASE DE LA APLICACIÓN (Recuperación de contraseña) ─────────
# Sin barra (/) al final.
# En Render: https://cultivus-co.onrender.com
APP_BASE_URL=http://localhost:8080

# ── 4. LÍMITES Y VIGENCIA DE RECUPERACIÓN DE CONTRASEÑA ───────────────
PASSWORD_RESET_TOKEN_TTL=15m
PASSWORD_RESET_WINDOW=15m
PASSWORD_RESET_MAX_EMAIL=3
PASSWORD_RESET_MAX_IP=10
PASSWORD_RESET_MAX_ATTEMPTS=20

# ── 5. CORREO SMTP (GMAIL / SERVIDOR DE CORREO) ───────────────────────
# Para Gmail necesitas activar la Verificación en 2 pasos y generar una
# "Contraseña de aplicación" de 16 letras (sin espacios).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion_16_caracteres
MAIL_FROM=tu-correo@gmail.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SSL=false
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000

# --- Alternativa local con Mailpit (sin enviar correos reales) ---
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@cultivus.local
# MAIL_SMTP_AUTH=false
# MAIL_STARTTLS=false
# MAIL_STARTTLS_REQUIRED=false

# ── 6. WOMPI — PASARELA DE PAGOS ──────────────────────────────────────
# Valores por defecto de Sandbox (Pruebas):
WOMPI_PUBLIC_KEY=pub_test_SNAgAz0t1alYmMcANF4RypmvxP2yHAsN
WOMPI_PRIVATE_KEY=prv_test_87fWXHu1p1NcE9t8QAxjpH7e8RnxGvR4
WOMPI_INTEGRITY_SECRET=test_integrity_3a1S6QNgkqJ7OuVQc6S5pBycOtoNgsys
WOMPI_EVENTS_SECRET=test_events_ieM3hdM7Nhuw0jxX5fOIW6Q3oAFQ7fZi
WOMPI_CURRENCY=COP
# En producción usar: https://production.wompi.co/v1
WOMPI_API_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_API_TIMEOUT_MS=4000

# ── 7. LOGÍSTICA / ENVÍO ──────────────────────────────────────────────
CULTIVUS_ENVIO_PROVISIONAL=10000.0

# ── 8. OAUTH2 (GOOGLE & FACEBOOK - OPCIONAL) ──────────────────────────
# Google Cloud Console:
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=

# Meta for Developers (Facebook):
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_FACEBOOK_CLIENT_ID=1354087329952384
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_FACEBOOK_CLIENT_SECRET=a061e4e31b65748ac6e05155df08af61

