# ====================================================================
# DOCKERFILE.DEV - Imagen optimizada para DESARROLLO/TESTING
# ====================================================================

# ====================================================================
# ETAPA 1: CONSTRUCCIÓN (Build Stage)
# ====================================================================
FROM maven:3.9.9-eclipse-temurin-17 AS builder

WORKDIR /build

# Copiar solo pom.xml primero para caché de capas
COPY pom.xml .

# Descargar dependencias en paralelo
RUN mvn dependency:go-offline -B -q

# Copiar código fuente completo
COPY src ./src

# Compilar sin ejecutar tests
RUN mvn clean package -q -DskipTests

# ====================================================================
# ETAPA 2: EJECUCIÓN (Runtime Stage) - Imagen para desarrollo
# ====================================================================
FROM eclipse-temurin:17-jre-jammy

# Metadatos
LABEL maintainer="Cultivus Team"
LABEL description="Cultivus Development Image - Spring Boot with MongoDB"

# Variables de entorno para desarrollo
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0 -Dfile.encoding=UTF-8"
ENV SPRING_PROFILES_ACTIVE=dev
ENV PORT=8080

WORKDIR /app

# Copiar JAR desde etapa de construcción
COPY --from=builder /build/target/demo-0.0.1-SNAPSHOT.jar app.jar

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/ || exit 1

# Exponer puerto
EXPOSE 8080

# Iniciar aplicación
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
