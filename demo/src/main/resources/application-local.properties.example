# =======================================================
# CONFIGURACIÓN LOCAL DE EJEMPLO
# =======================================================
# Este archivo sirve como plantilla. Para usarlo localmente:
# 1. Copia este archivo y renómbralo a application-local.properties
# 2. Reemplaza los valores con tus credenciales reales
# 3. NO subas el archivo application-local.properties a Git

# MongoDB
# MONGODB_URI=mongodb://localhost:27017/cultivus

# Google OAuth2 (Google Cloud Console)
# GOOGLE_CLIENT_ID=tu_client_id_aqui
# GOOGLE_CLIENT_SECRET=tu_client_secret_aqui
